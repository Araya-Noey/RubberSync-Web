# RubberSync environment variables
PORT=8080
AUTH_SECRET=change-this-to-a-long-random-secret
APP_TIME_ZONE=Asia/Bangkok

# ส่งข้อความ RubberSync -> Discord
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# รับข้อความ Discord -> RubberSync (Bot ต้องมี View Channel + Read Message History)
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CHANNEL_ID=your-discord-channel-id

# ทางเลือก: ถ้าใช้ bridge ภายนอก POST เข้า /api/discord/inbound
DISCORD_INBOUND_SECRET=change-this-secret
